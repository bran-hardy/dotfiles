#!/usr/bin/env bash
# Set wallpaper and regenerate theme from it via matugen.
# Usage: set-wallpaper <path-to-image>

set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "Usage: set-wallpaper <path-to-image>"
  exit 1
fi

WALLPAPER="$(realpath "$1")"
DOTFILES="$HOME/dotfiles"

if [[ ! -f "$WALLPAPER" ]]; then
  echo "File not found: $WALLPAPER"
  exit 1
fi

echo "▶ Generating palette from $(basename "$WALLPAPER")..."
# matugen --config "$DOTFILES/theme/matugen/config.toml" image "$WALLPAPER" -m "dark"
matugen --config "$DOTFILES/theme/matugen/config.toml" color hex "#636157" -m "dark"

echo "▶ Setting wallpaper..."
awww img "$WALLPAPER" --transition-type any --transition-duration 1

echo "▶ Reloading apps..."
hyprctl reload 2>/dev/null || true
pkill -SIGUSR2 waybar 2>/dev/null || true
touch "$DOTFILES/config/wezterm/wezterm.lua" 2>/dev/null || true

echo "$WALLPAPER" > "$DOTFILES/theme/current-wallpaper"
echo "✓ Done — theme set from $(basename "$WALLPAPER")"
