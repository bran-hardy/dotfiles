{
    "battery": {
        "interval": 60,
        "states": {
            "warning": 30,
            "critical": 15,
        },
        "format": "{icon}",
        "format-full": "{icon}",
        "format-charging": "<span size='12pt'>󱐌</span>",
        "format-plugged": "",
        "format-alt": "{icon}",
        "tooltip-format": "{capacity}%\n\n{timeTo}\n\n󰠠  Usage: {power:0.1f}W\n󱤅  Condition: {health}%\n󱍸  Total: {cycles} cycles",
        "format-icons": {
            "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        },
    },
}
